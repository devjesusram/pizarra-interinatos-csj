# Copie este archivo como .env y complete los valores:
#   cp .env.example .env
# ¡No suba el archivo .env al repositorio!

# Contraseña de la base de datos (invente una larga; no hace falta recordarla)
DB_PASSWORD=cambie-esta-clave-por-una-larga

# Puerto en el que se abre el sistema: http://<servidor>:8080
PUERTO=8080

NOMBRE_CIRCUNSCRIPCION=Circunscripción Judicial de Cordillera

# Horas que dura una sesión antes de pedir de nuevo la contraseña
SESION_HORAS=12

# Ponga true solo si sirve el sistema detrás de HTTPS
COOKIE_SEGURA=false

# Opcional: token largo para el calendario .ics general de toda la circunscripción
# (se usa como http://<servidor>:8080/ics/<token>.ics). Vacío = desactivado.
# Para generar uno:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ICS_TOKEN_GENERAL=
